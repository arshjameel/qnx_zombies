static func is_wall(mx: int, my: int) -> bool:
	if mx < 0 or mx >= MAP_W or my < 0 or my >= MAP_ROWS:
		return true
	return GRID[my][mx] != 0

static func tile(mx: int, my: int) -> int:
	if mx < 0 or mx >= MAP_W or my < 0 or my >= MAP_ROWS:
		return 1
	return GRID[my][mx]
